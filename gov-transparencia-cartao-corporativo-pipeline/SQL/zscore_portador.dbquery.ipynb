   "source": [
    "SELECT\n",
    "  *,\n",
    "\n",
    "  (total_mes - AVG(total_mes) OVER (\n",
    "     PARTITION BY id_hash_estabelecimento\n",
    "   )) /\n",
    "   NULLIF(STDDEV(total_mes) OVER (\n",
    "     PARTITION BY id_hash_estabelecimento\n",
    "   ), 0) AS z_score\n",
    "FROM gov_transparencia.gold.gold_series_temporais_estabelecimentos;"
   ]
  }
 ],
